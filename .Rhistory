# E. Peak Hour Usage vs Total Consumption
ggplot(data, aes(x = Peak_Hours_Usage_kWh, y = Energy_Consumption_kWh)) +
  geom_point(alpha = 0.3, color = "purple") +
  geom_smooth(method = "lm") +
  labs(title = "Peak Hour Usage vs Total Energy",
       x = "Peak Hour Usage (kWh)",
       y = "Total Energy (kWh)")
# Household Energy Consumption - Complete Data Cleansing + Visualization in R
# STEP 1: Load required libraries
# Run the below lines only once if packages are not installed:
# install.packages("tidyverse")
# install.packages("lubridate")
# install.packages("ggplot2")
library(tidyverse)
library(lubridate)
library(ggplot2)
# STEP 2: Set working directory (adjust this to your actual file location)
setwd("C:/Users/dines/Downloads")  # <-- CHANGE THIS PATH IF NEEDED
# STEP 3: Load the dataset
data <- read.csv("household_energy_consumption.csv")
# STEP 4: Convert data types
data$Date <- as.Date(data$Date, format = "%Y-%m-%d")   # Fix date column
data$Has_AC <- as.factor(data$Has_AC)                 # Convert to categorical
data$Household_ID <- as.factor(data$Household_ID)     # Convert to categorical
# STEP 5: Handle missing values
colSums(is.na(data))        # View NA counts per column
data <- na.omit(data)       # Remove rows with missing values
# STEP 6: Remove duplicates
data <- distinct(data)
# STEP 7: Feature engineering
data$DayOfWeek <- weekdays(data$Date)
data$IsWeekend <- ifelse(data$DayOfWeek %in% c("Saturday", "Sunday"), "Yes", "No")
# STEP 8: Export the cleaned dataset
write.csv(data, "cleaned_energy_data.csv", row.names = FALSE)
# STEP 9: Visualization
# A. Daily Average Energy Consumption
daily_avg <- data %>%
  group_by(Date) %>%
  summarise(Avg_Energy = mean(Energy_Consumption_kWh, na.rm = TRUE))
ggplot(daily_avg, aes(x = Date, y = Avg_Energy)) +
  geom_line(color = "blue") +
  labs(title = "Average Energy Consumption Over Time",
       x = "Date",
       y = "Average kWh")
# B. Energy Consumption by Household Size
ggplot(data, aes(x = factor(Household_Size), y = Energy_Consumption_kWh)) +
  geom_boxplot(fill = "orange") +
  labs(title = "Energy Consumption by Household Size",
       x = "Household Size",
       y = "Energy (kWh)")
# C. AC Ownership vs Energy Consumption
ggplot(data, aes(x = Has_AC, y = Energy_Consumption_kWh)) +
  geom_boxplot(fill = "green") +
  labs(title = "AC Ownership vs Energy Consumption",
       x = "Has AC",
       y = "Energy (kWh)")
# D. Temperature vs Energy Usage
ggplot(data, aes(x = Avg_Temperature_C, y = Energy_Consumption_kWh)) +
  geom_point(alpha = 0.4) +
  geom_smooth(method = "lm", color = "red") +
  labs(title = "Temperature vs Energy Consumption",
       x = "Avg Temp (C)",
       y = "Energy (kWh)")
# E. Peak Hour Usage vs Total Consumption
ggplot(data, aes(x = Peak_Hours_Usage_kWh, y = Energy_Consumption_kWh)) +
  geom_point(alpha = 0.3, color = "purple") +
  geom_smooth(method = "lm") +
  labs(title = "Peak Hour Usage vs Total Energy",
       x = "Peak Hour Usage (kWh)",
       y = "Total Energy (kWh)")
q()
